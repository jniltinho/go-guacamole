# Copy to .env and adjust. Every variable can also be set in config.toml
# ([app] secret_key ↔ APP_SECRET_KEY, [db] dsn ↔ DB_DSN, ...). Env wins over the file.

# development | production | test
APP_ENV=development
# Public URL (used for the WebSocket Origin check behind proxies)
APP_BASE_URL=http://localhost:8080
# 32+ characters; encrypts connection secrets at rest. Generate: openssl rand -hex 32
# Leave empty to auto-generate /data/secret.key (back it up with the database!)
APP_SECRET_KEY=
# Bootstrap administrator (only used when the database has no users)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
# Set true when TLS is terminated by a reverse proxy
APP_COOKIE_SECURE=false
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For
APP_TRUSTED_PROXIES=

# sqlite (default) | mysql | postgres
DB_DRIVER=sqlite
DB_DSN=/data/goguacamole.db
# MariaDB:    DB_DRIVER=mysql    DB_DSN=goguacamole:goguacamole@tcp(mariadb:3306)/goguacamole
# PostgreSQL: DB_DRIVER=postgres DB_DSN=postgres://goguacamole:goguacamole@postgres:5432/goguacamole?sslmode=disable
DB_PASSWORD=goguacamole

# Native HTTPS (make certs creates ./deploy/certs/server.{crt,key})
TLS_ENABLED=false
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key

HTTP_PORT=8080
HTTPS_PORT=8443
